+def _calibrate() -> float:
+    """CPU-время фиксированной нагрузки на чистом Python, около 30 мс."""
+    import hashlib
+    t = _cpu()
+    acc = {}
+    data = b"x" * 4096
+    for i in range(6000):
+        acc[i % 997] = hashlib.md5(data + i.to_bytes(4, "little")).digest()[:4]
+        _ = sorted(acc.values())[:3] if i % 500 == 0 else None
+    return _cpu() - t
+
